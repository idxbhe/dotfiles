#!/bin/sh
# =============================================================
# Author: gh0stzk (adapted for shiki)
# Repo:   https://github.com/gh0stzk/dotfiles
# Date:   2026-08-04
#
# Script Name: Bspwm-ShikiPad
# Description: Dynamic scratchpad for shiki TUI notes manager
# Features:
#   - Monitor-aware geometry calculations
#   - Percentage-based sizing (85% width/85% height)
#   - Multi-terminal support (Alacritty/st/kitty/ghostty)
#   - Auto-hide/show toggle functionality (persistent, no terminate)
#   - Persistent window positioning across monitor changes
# Dependencies:
#   - bspwm (>= 0.9.10)
#   - jq (JSON processing)
#   - xdo (window operations)
#   - xprop (window identification)
#
# Licensed under GPL-3.0 license
# =============================================================

# Main vars
SCRATCHPAD_NAME="bspwm-shiki"
CFG_TERM="$HOME/.config/bspwm/config/.term"
read -r MY_TERM < "$CFG_TERM"
MAX_WIDTH_PERCENT=85
HEIGHT_PERCENT=85

# Function to get geometry of current monitor
get_monitor_geometry() {
    mon_geo=$(bspc query -T -m focused | jq -r '.rectangle | "\(.width) \(.height) \(.x) \(.y)"')
    SCREEN_WIDTH=$(echo "$mon_geo" | awk '{print $1}')
    SCREEN_HEIGHT=$(echo "$mon_geo" | awk '{print $2}')
    MONITOR_X=$(echo "$mon_geo" | awk '{print $3}')
    MONITOR_Y=$(echo "$mon_geo" | awk '{print $4}')
}

# Function to calculate position and size
calculate_position() {
    WIDTH=$((SCREEN_WIDTH * MAX_WIDTH_PERCENT / 100))
    HEIGHT=$((SCREEN_HEIGHT * HEIGHT_PERCENT / 100))
    X_POS=$((MONITOR_X + (SCREEN_WIDTH - WIDTH) / 2))
    Y_POS=$((MONITOR_Y + (SCREEN_HEIGHT - HEIGHT) / 2))
}

# Function to find the window
get_scratchpad_id() {
    bspc query -N -n ".floating.window" | while read -r node; do
        if xprop -id "$node" WM_CLASS | grep -q "$SCRATCHPAD_NAME"; then
            echo "$node"
            return
        fi
    done
}

# Get current geometry
get_monitor_geometry
calculate_position

# Find existing window
WINDOW_ID=$(get_scratchpad_id)

if [ -n "$WINDOW_ID" ]; then
    # Get current status
    CURRENT_STATE=$(bspc query -T -n "$WINDOW_ID" | jq -r '.hidden')

    if [ "$CURRENT_STATE" = "false" ]; then
        # If already visible: hide (do NOT terminate)
        bspc node "$WINDOW_ID" -g hidden
    else
        # If hidden: move, resize and show
        bspc node "$WINDOW_ID" -m focused
        xdo move -x "$X_POS" -y "$Y_POS" "$WINDOW_ID"
        xdo resize -w "$WIDTH" -h "$HEIGHT" "$WINDOW_ID"
        bspc node "$WINDOW_ID" -g hidden=off -f
    fi
else
    # Selector depends on terminal: ghostty only controls instance field
    if [ "$MY_TERM" = "ghostty" ]; then
        RULE_SELECTOR="*:$SCRATCHPAD_NAME"
    else
        RULE_SELECTOR="$SCRATCHPAD_NAME"
    fi
    # Create rule for new node
    bspc rule -a "$RULE_SELECTOR" \
        state=floating \
        sticky=on \
        layer=above \
        rectangle="${WIDTH}x${HEIGHT}+${X_POS}+${Y_POS}" \
        --one-shot

    # Launch the corresponding terminal with shiki
    case $MY_TERM in
        "alacritty") alacritty -o window.opacity=0.93 --class "$SCRATCHPAD_NAME" -e shiki & ;;
        "st") st -A 0.93 -c "$SCRATCHPAD_NAME" -e shiki & ;;
        "kitty") kitty -o background_opacity=0.93 --class="$SCRATCHPAD_NAME" -e shiki & ;;
        "ghostty") ghostty --background-opacity=0.93 --x11-instance-name="$SCRATCHPAD_NAME" -e shiki & ;;
    esac

    # Wait and adjust final position
    sleep 0.3
    WINDOW_ID=$(get_scratchpad_id)
    xdo move -x "$X_POS" -y "$Y_POS" "$WINDOW_ID"
    xdo resize -w "$WIDTH" -h "$HEIGHT" "$WINDOW_ID"
fi

# Update when changing monitor
bspc subscribe monitor_focus | while read -r _; do
    get_monitor_geometry
    calculate_position
    WINDOW_ID=$(get_scratchpad_id)

    if [ -n "$WINDOW_ID" ]; then
        # Move and resize only if visible
        if [ "$(bspc query -T -n "$WINDOW_ID" | jq -r '.client.state')" = "floating" ]; then
            bspc node "$WINDOW_ID" -m focused
            xdo move -x "$X_POS" -y "$Y_POS" "$WINDOW_ID"
            xdo resize -w "$WIDTH" -h "$HEIGHT" "$WINDOW_ID"
        fi
    fi
done &