// https://github.com/idxbhe/dotfiles
// SddmSelector rofi theme - mirrors RiceSelector.rasi style
// 6-column icon grid layout, preview thumbnails

configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "{name}";
    font:                        "JetBrainsMono NF Bold 11";
}

* {
    main-bg:     #14171c;
    main-fg:     #b8bfe5;
    select-bg:   #7560d3;
    select-fg:   #14171c;
    urgent-bg:   #f7768e;
    urgent-fg:   #14171c;
}

window {
    enabled:                     true;
    fullscreen:                  false;
    width:                       100%;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
}

mainbox {
    enabled:                     true;
    children:                    [ "listview" ];
    background-color:            @main-bg;
}

listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    spacing:                     40px;
    padding:                     20px;
    cycle:                       true;
    dynamic:                      false;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}

element {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     0px;
    padding:                     7px;
    border-radius:               20px;
    border:                      0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      "default";
}

element normal.active {
    background-color:            transparent;
    text-color:                  @main-fg;
}

element selected.active {
    background-color:            @select-bg;
    text-color:                  @select-fg;
    border-radius:               20px;
}

element-icon {
    enabled:                     true;
    size:                        96px;
    cursor:                      "default";
    background-color:            transparent;
}

element-text {
    enabled:                     true;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    margin:                      0px 0px 0px 0px;
    padding:                     8px 0px 0px 0px;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrainsMono NF Bold 9";
}
